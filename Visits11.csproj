<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The standalone/default EXE is for ESP32. No marker/configuration file required. -->
    <TerminalMode Condition="'$(TerminalMode)' == ''">Board</TerminalMode>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Visits11</RootNamespace>
    <AssemblyName>Visits11</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TerminalMode)' == 'Phone'">
    <DefineConstants>$(DefineConstants);PHONE_TERMINAL</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateTerminalMode" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(TerminalMode)' != 'Board' and '$(TerminalMode)' != 'Phone'"
           Text="TerminalMode must be Board or Phone." />
  </Target>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
