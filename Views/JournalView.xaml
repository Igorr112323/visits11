<UserControl x:Class="Visits11.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <UserControl.Resources>
        <DataTemplate x:Key="Tpl.LessonItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DateText}" FontSize="14"
                               FontFamily="{StaticResource Font.SemiBold}"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="{Binding TimeText}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextSoft}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RatioText}" FontSize="13"
                               FontFamily="{StaticResource Font.SemiBold}"
                               Foreground="{DynamicResource Brush.TextDim}"
                               HorizontalAlignment="Right" />
                    <Border x:Name="PercentBadge" CornerRadius="20" Padding="8,3"
                            Background="{DynamicResource Brush.GreenSoft}"
                            Margin="0,5,0,0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PercentText}" FontSize="11"
                                   FontFamily="{StaticResource Font.SemiBold}"
                                   Foreground="{DynamicResource Brush.Green}" />
                    </Border>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Path="Percent" Converter="{StaticResource Conv.LessThan}" ConverterParameter="0.8" />
                    </DataTrigger.Binding>
                    <Setter TargetName="PercentBadge" Property="Background" Value="{DynamicResource Brush.YellowSoft}" />
                    <Setter TargetName="PercentBadge" Property="TextElement.Foreground" Value="{DynamicResource Brush.Yellow}" />
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Path="Percent" Converter="{StaticResource Conv.LessThan}" ConverterParameter="0.5" />
                    </DataTrigger.Binding>
                    <Setter TargetName="PercentBadge" Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                    <Setter TargetName="PercentBadge" Property="TextElement.Foreground" Value="{DynamicResource Brush.Red}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================ ГРУППА И ЗАНЯТИЯ (ЛЕВО) -->

        <Border Grid.Column="0" Margin="0,0,20,0"
                CornerRadius="20"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Effect="{StaticResource Effect.ShadowMd}">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="ГРУППА" Style="{StaticResource Txt.Label}" />
                    <ComboBox Margin="0,10,0,0"
                              Style="{StaticResource Widget.Dropdown}"
                              ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}"
                              DisplayMemberPath="Name" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lessons}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Widget.LessonCard}"
                                        Margin="0,0,0,8"
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource Tpl.LessonItem}"
                                        Command="{Binding DataContext.SelectLessonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ==================================================== ДЕТАЛИ (ПРАВО) -->

        <Border Grid.Column="1"
                CornerRadius="20"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Effect="{StaticResource Effect.ShadowMd}">
            <Grid Margin="22">
                <!-- пустое состояние -->
                <TextBlock Text="Выберите занятие"
                           FontSize="14" Foreground="{DynamicResource Brush.TextSoft}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasLesson, Converter={StaticResource Conv.BoolToVis}, ConverterParameter=invert}" />

                <Grid Visibility="{Binding HasLesson, Converter={StaticResource Conv.BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- заголовок + экспорт -->
                    <Grid>
                        <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource Txt.H1}"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource Btn.Violet}"
                                Command="{Binding ExportCommand}"
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Export}" Width="15" Height="15" Stretch="Uniform"
                                      Stroke="#FFFFFF" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock Text="Экспорт" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- статкарточки -->
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card.Stat}">
                            <StackPanel>
                                <TextBlock Text="ВСЕГО" Style="{StaticResource Txt.Label}" />
                                <TextBlock Text="{Binding TotalText}" FontSize="22"
                                           FontFamily="{StaticResource Font.ExtraBold}"
                                           Foreground="{DynamicResource Brush.Text}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card.Stat}">
                            <StackPanel>
                                <TextBlock Text="ПРИСУТСТВОВАЛИ" Style="{StaticResource Txt.Label}" />
                                <TextBlock Text="{Binding PresentText}" FontSize="22"
                                           FontFamily="{StaticResource Font.ExtraBold}"
                                           Foreground="{DynamicResource Brush.Green}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource Card.Stat}">
                            <StackPanel>
                                <TextBlock Text="ОТСУТСТВОВАЛИ" Style="{StaticResource Txt.Label}" />
                                <TextBlock Text="{Binding AbsentText}" FontSize="22"
                                           FontFamily="{StaticResource Font.ExtraBold}"
                                           Foreground="{DynamicResource Brush.Red}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- таблица -->
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                                Padding="0,0,10,10" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="№" Style="{StaticResource Txt.Label}" />
                                <TextBlock Grid.Column="1" Text="ФИО" Style="{StaticResource Txt.Label}" />
                                <TextBlock Grid.Column="2" Text="Статус" Style="{StaticResource Txt.Label}" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,10" BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Number}"
                                                           FontSize="12" FontFamily="{StaticResource Font.Medium}"
                                                           Foreground="{DynamicResource Brush.TextSoft}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding FullName}"
                                                           Style="{StaticResource Txt.Body}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="2" CornerRadius="20" Padding="11,4"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource Brush.RedSoft}"
                                                        TextElement.Foreground="{DynamicResource Brush.Red}">
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Txt.Badge}" />
                                                </Border>
                                                <Border Grid.Column="2" CornerRadius="20" Padding="11,4"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource Brush.GreenSoft}"
                                                        TextElement.Foreground="{DynamicResource Brush.Green}"
                                                        Visibility="{Binding Present, Converter={StaticResource Conv.BoolToVis}}">
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Txt.Badge}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
