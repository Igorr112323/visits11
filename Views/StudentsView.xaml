<UserControl x:Class="Visits11.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <UserControl.Resources>
        <DataTemplate x:Key="Tpl.GroupItem">
            <TextBlock Text="{Binding Name}" FontSize="14"
                       FontFamily="{StaticResource Font.SemiBold}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================== ГРУППЫ (ЛЕВО) -->

        <Border Grid.Column="0" Margin="0,0,20,0"
                CornerRadius="20"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Effect="{StaticResource Effect.ShadowMd}">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="Группы" Style="{StaticResource Txt.H2}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Btn.Soft}"
                            Command="{Binding NewGroupCommand}"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Plus}" Width="13" Height="13" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Новая" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Widget.GroupCard}"
                                        Margin="0,0,0,8"
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource Tpl.GroupItem}"
                                        Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================================================ СТУДЕНТЫ (ПРАВО) -->

        <Border Grid.Column="1"
                CornerRadius="20"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Effect="{StaticResource Effect.ShadowMd}">
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- заголовок -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource Txt.H1}" />
                    <TextBlock Text="{Binding HeaderCount}" FontSize="13"
                               Foreground="{DynamicResource Brush.TextDim}"
                               Margin="10,4,0,0" VerticalAlignment="Bottom" />
                </StackPanel>

                <!-- действия (WrapPanel: на узком окне кнопки переходят на вторую строку, а не обрезаются) -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource Btn.Green}" Command="{Binding AddStudentCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.UserPlus}" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="#FFFFFF" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Добавить студента" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Violet}" Command="{Binding ImportWordCommand}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Import}" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="#FFFFFF" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Импорт из Word" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Violet}" Command="{Binding ExportQrCommand}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Qr}" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="#FFFFFF" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Экспорт QR-кодов" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Soft}" Command="{Binding DeleteGroupCommand}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.X}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Red}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Удалить группу" Margin="7,0,0,0"
                                       Foreground="{DynamicResource Brush.Red}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- таблица -->
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- шапка -->
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                            Padding="0,0,10,10" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="№" Style="{StaticResource Txt.Label}" />
                            <TextBlock Grid.Column="1" Text="ФИО" Style="{StaticResource Txt.Label}" />
                            <TextBlock Grid.Column="2" Text="Вход по QR-коду" Style="{StaticResource Txt.Label}" />
                            <TextBlock Grid.Column="3" Text="Телефон" Style="{StaticResource Txt.Label}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Students}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,9" BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Number}"
                                                       FontSize="12" FontFamily="{StaticResource Font.Medium}"
                                                       Foreground="{DynamicResource Brush.TextSoft}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding FullName}"
                                                       Style="{StaticResource Txt.Body}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <!-- кнопка напротив студента: показать его QR-код -->
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource Btn.Soft}"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.ShowQrCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Показать QR-код студента">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.Qr}" Width="12" Height="12" Stretch="Uniform"
                                                          Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <TextBlock Text="QR-код" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>

                                            <!-- привязан ли студент к телефону (защита от отметок с чужого устройства) -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding DeviceLabel}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Brush.TextSoft}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DeviceId, Converter={StaticResource Conv.NullToVis}}" Value="Visible">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
                                                                <Setter Property="FontFamily" Value="{StaticResource Font.SemiBold}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Grid.Column="4"
                                                    Style="{StaticResource Btn.Icon}"
                                                    Width="30" Height="30"
                                                    HorizontalAlignment="Center"
                                                    Command="{Binding DataContext.DeleteStudentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Удалить студента">
                                                <Path Data="{StaticResource Icon.X}" Width="11" Height="11" Stretch="Uniform"
                                                      Stroke="{DynamicResource Brush.Red}" StrokeThickness="2.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
