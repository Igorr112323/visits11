<Window x:Class="Visits11.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Visits11.ViewModels"
        xmlns:views="clr-namespace:Visits11.Views"
        xmlns:services="clr-namespace:Visits11.Services"
        Title="Журнал КубГАУ"
        Width="1280" Height="800"
        MinWidth="1160" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Default}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- без системной полосы заголовка -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- кнопки управления окном -->
        <Style x:Key="Style.WinControl" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Panel3}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.WinClose" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type vm:LessonViewModel}">
            <views:LessonView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentsViewModel}">
            <views:StudentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:JournalViewModel}">
            <views:JournalView />
        </DataTemplate>

        <!-- ============================================== МОДАЛЬНОЕ ОКНО == -->

        <DataTemplate DataType="{x:Type vm:ModalViewModel}">
            <Border x:Name="Card"
                    Width="480"
                    CornerRadius="20"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Effect="{StaticResource Effect.ShadowLg}"
                    Padding="28"
                    FocusManager.FocusedElement="{Binding ElementName=ModalInput}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 From="0.94" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                 From="0.94" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Txt.H2}" />
                    <TextBlock Text="{Binding Message}"
                               Style="{StaticResource Txt.Dim}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Visibility="{Binding Message, Converter={StaticResource Conv.StringToVis}}" />
                    <StackPanel Margin="0,18,0,0"
                                Visibility="{Binding ShowInput, Converter={StaticResource Conv.BoolToVis}}">
                        <TextBlock Text="{Binding InputLabel}" Style="{StaticResource Txt.Label}" />
                        <TextBox x:Name="ModalInput"
                                 Style="{StaticResource Widget.Input}"
                                 Margin="0,8,0,0"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding ShowInput2, Converter={StaticResource Conv.BoolToVis}}">
                        <TextBlock Text="{Binding InputLabel2}" Style="{StaticResource Txt.Label}" />
                        <TextBox Style="{StaticResource Widget.Input}"
                                 Margin="0,8,0,0"
                                 Text="{Binding InputText2, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                        <Button Content="Отмена"
                                Style="{StaticResource Btn.Ghost}"
                                Command="{Binding CancelCommand}"
                                IsCancel="True" />
                        <Button Content="{Binding ConfirmText}"
                                Style="{StaticResource Btn.Primary}"
                                Command="{Binding ConfirmCommand}"
                                IsDefault="True"
                                MinWidth="130"
                                Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ======================================================= ТОСТ == -->

        <DataTemplate DataType="{x:Type services:Toast}">
            <Border x:Name="Root"
                    Width="320"
                    CornerRadius="14"
                    ClipToBounds="True"
                    Margin="0,0,0,10"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Effect="{StaticResource Effect.ShadowLg}">
                <Border.RenderTransform>
                    <TranslateTransform X="380" />
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                 From="380" To="0" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Progress"
                                                 Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                 From="1" To="0"
                                                 Duration="0:0:3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- цветная полоса слева -->
                    <Border x:Name="BarSuccess" Grid.RowSpan="2" Width="4" CornerRadius="2,0,0,2"
                            Background="{DynamicResource Brush.Green}" Visibility="Collapsed" />
                    <Border x:Name="BarError" Grid.RowSpan="2" Width="4" CornerRadius="2,0,0,2"
                            Background="{DynamicResource Brush.Red}" Visibility="Collapsed" />
                    <Border x:Name="BarInfo" Grid.RowSpan="2" Width="4" CornerRadius="2,0,0,2"
                            Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />

                    <!-- иконка -->
                    <Border x:Name="IconBg" Grid.Column="1" Width="32" Height="32" CornerRadius="10"
                            Margin="12,12,0,12" Background="{DynamicResource Brush.GreenSoft}">
                        <Grid>
                            <Path x:Name="IconSuccess" Data="{StaticResource Icon.CheckCircle}"
                                  Width="17" Height="17" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Green}" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                            <Path x:Name="IconError" Data="{StaticResource Icon.AlertCircle}"
                                  Width="17" Height="17" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Red}" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                            <Path x:Name="IconInfo" Data="{StaticResource Icon.Info}"
                                  Width="17" Height="17" Stretch="Uniform"
                                  Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.7"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- текст -->
                    <StackPanel Grid.Column="2" Margin="12,10,14,10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13"
                                   FontFamily="{StaticResource Font.SemiBold}"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextDim}" Margin="0,2,0,0"
                                   Visibility="{Binding Message, Converter={StaticResource Conv.StringToVis}}" />
                    </StackPanel>

                    <!-- полоска прогресса -->
                    <Border x:Name="Progress" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                            Height="3" CornerRadius="2" Margin="0,0,14,10"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource Brush.Green}"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Success">
                    <Setter TargetName="BarSuccess" Property="Visibility" Value="Visible" />
                    <Setter TargetName="IconSuccess" Property="Visibility" Value="Visible" />
                    <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
                    <Setter TargetName="Progress" Property="Background" Value="{DynamicResource Brush.Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Error">
                    <Setter TargetName="BarError" Property="Visibility" Value="Visible" />
                    <Setter TargetName="IconError" Property="Visibility" Value="Visible" />
                    <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource Brush.RedSoft}" />
                    <Setter TargetName="Progress" Property="Background" Value="{DynamicResource Brush.Red}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Info">
                    <Setter TargetName="BarInfo" Property="Visibility" Value="Visible" />
                    <Setter TargetName="IconInfo" Property="Visibility" Value="Visible" />
                    <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter TargetName="Progress" Property="Background" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- фон: базовый цвет + радиальные подсветки -->
        <Rectangle Fill="{DynamicResource Brush.Bg}" />
        <Rectangle Fill="{DynamicResource Brush.Bg.Glow1}" />
        <Rectangle Fill="{DynamicResource Brush.Bg.Glow2}" />

        <!-- основная раскладка -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ТОПБАР -->
            <Border Background="{DynamicResource Brush.Topbar}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Topbar_OnMouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,196,0">
                        <RadioButton Style="{StaticResource Widget.TabToggle}"
                                     GroupName="Tabs"
                                     Tag="{StaticResource Icon.Camera}"
                                     Content="Занятия"
                                     IsChecked="{Binding TabLessons, Mode=TwoWay}"
                                     Margin="0,0,6,0" />
                        <RadioButton Style="{StaticResource Widget.TabToggle}"
                                     GroupName="Tabs"
                                     Tag="{StaticResource Icon.Users}"
                                     Content="Студенты"
                                     IsChecked="{Binding TabStudents, Mode=TwoWay}"
                                     Margin="0,0,6,0" />
                        <RadioButton Style="{StaticResource Widget.TabToggle}"
                                     GroupName="Tabs"
                                     Tag="{StaticResource Icon.Book}"
                                     Content="Журнал"
                                     IsChecked="{Binding TabJournal, Mode=TwoWay}" />
                        <Button Style="{StaticResource Btn.Soft}"
                                Command="{Binding ConfigureServerCommand}"
                                Content="{Binding ServerStatusText}"
                                Margin="18,0,0,0"
                                Padding="12,7"
                                ToolTip="Настроить подключение к серверу" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Icon}"
                                Command="{Binding ToggleThemeCommand}"
                                VerticalAlignment="Center" Margin="0,0,12,0"
                                ToolTip="Переключить тему">
                            <Grid Width="18" Height="18">
                                <Path Data="{StaticResource Icon.Sun}"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.TextDim}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="{Binding IsDarkTheme, Converter={StaticResource Conv.BoolToVis}}" />
                                <Path Data="{StaticResource Icon.Moon}"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.TextDim}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="{Binding IsDarkTheme, Converter={StaticResource Conv.BoolToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </Button>

                        <!-- свои кнопки управления окном -->
                        <Button Style="{StaticResource Style.WinControl}" Click="MinimizeButton_Click" ToolTip="Свернуть">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Data="M 0,5 H 10" />
                        </Button>
                        <Button Style="{StaticResource Style.WinControl}" Click="MaximizeButton_Click" ToolTip="Развернуть">
                            <Grid>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1" Data="M 0,0 H 10 V 10 H 0 Z">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1" Data="M 2,8 V 2 H 8 M 0,6 V 0 H 6">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource Style.WinClose}" Click="CloseButton_Click" ToolTip="Закрыть">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ВКЛАДКИ -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentTab}"
                            Margin="24,20,24,24"
                            Focusable="False" />
        </Grid>

        <!-- МОДАЛЬНЫЙ ОВЕРЛЕЙ -->
        <Grid Visibility="{Binding CurrentModal, Converter={StaticResource Conv.NullToVis}}"
              Background="#590A0D1A">
            <ContentControl Content="{Binding CurrentModal}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Focusable="False" />
        </Grid>

        <!-- ТОСТЫ (снизу справа) -->
        <ItemsControl ItemsSource="{Binding Toasts.Toasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,20,20"
                      IsHitTestVisible="False"
                      Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</Window>
