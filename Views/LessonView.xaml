<UserControl x:Class="Visits11.Views.LessonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Visits11.Controls"
             Focusable="False">

    <UserControl.Resources>
        <!-- сетка 40x40 из тонких линий -->
        <DrawingBrush x:Key="Brush.GridPattern" TileMode="Tile"
                      Viewport="0,0,40,40" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M0,0 L40,0 M0,0 L0,40">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#0AFFFFFF" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- радиальные подсветки панели камеры -->
        <RadialGradientBrush x:Key="Brush.ScanGlowBlue" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#3D6366F1" Offset="0" />
            <GradientStop Color="#006366F1" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="Brush.ScanGlowViolet" Center="0.5,0.5" GradientOrigin="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#3D8B5CF6" Offset="0" />
            <GradientStop Color="#008B5CF6" Offset="1" />
        </RadialGradientBrush>

        <!-- линия сканирования -->
        <LinearGradientBrush x:Key="Brush.ScanLine" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00A5B4FC" Offset="0" />
            <GradientStop Color="#FFA5B4FC" Offset="0.5" />
            <GradientStop Color="#00A5B4FC" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" MinWidth="480" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- ================================================== ПАНЕЛЬ КАМЕРЫ -->

        <Border Grid.Column="0" Margin="0,0,20,0"
                CornerRadius="20"
                Background="{DynamicResource Brush.Camera.Bg}"
                BorderBrush="#1AFFFFFF" BorderThickness="1"
                Effect="{StaticResource Effect.ShadowMd}">
            <Grid ClipToBounds="True">
                <!-- подсветки -->
                <Ellipse Width="560" Height="560" Fill="{StaticResource Brush.ScanGlowBlue}"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-180,-220,0,0" />
                <Ellipse Width="520" Height="520" Fill="{StaticResource Brush.ScanGlowViolet}"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-200" />

                <!-- сетка -->
                <Rectangle Fill="{StaticResource Brush.GridPattern}" />

                <!-- видеопоток с телефона преподавателя -->
                <Image Source="{Binding StreamFrame}"
                       Stretch="Uniform"
                       Visibility="{Binding HasStream, Converter={StaticResource Conv.BoolToVis}}" />

                <!-- центр: плейсхолдер камеры (когда телефон не подключён) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasStream, Converter={StaticResource Conv.BoolToVis}, ConverterParameter=invert}">
                    <Border Width="80" Height="80" CornerRadius="24"
                            Background="{DynamicResource Brush.Camera.IconBg}"
                            BorderBrush="{DynamicResource Brush.Camera.IconBorder}" BorderThickness="1"
                            HorizontalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                         From="0" To="-6"
                                                         Duration="0:0:1.5"
                                                         AutoReverse="True"
                                                         RepeatBehavior="Forever">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Path Data="{StaticResource Icon.Camera}"
                              Width="34" Height="34" Stretch="Uniform"
                              Stroke="{DynamicResource Brush.Camera.Text}" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <TextBlock Text="Ожидание видеопотока"
                               FontSize="15" FontFamily="{StaticResource Font.SemiBold}"
                               Foreground="{DynamicResource Brush.Camera.Text}"
                               HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="Подключите камеру через USB"
                               FontSize="12.5"
                               Foreground="{DynamicResource Brush.Camera.TextDim}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <!-- рамка сканирования -->
                <Grid x:Name="ScanFrame" Margin="34">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RollcallState}" Value="Active">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- уголки со свечением -->
                    <Border Width="28" Height="3" CornerRadius="1.5" Background="#A5B4FC"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Effect="{StaticResource Effect.GlowScan}" />
                    <Border Width="3" Height="28" CornerRadius="1.5" Background="#A5B4FC"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Effect="{StaticResource Effect.GlowScan}" />
                    <Border Width="28" Height="3" CornerRadius="1.5" Background="#A5B4FC"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Effect="{StaticResource Effect.GlowScan}" />
                    <Border Width="3" Height="28" CornerRadius="1.5" Background="#A5B4FC"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Effect="{StaticResource Effect.GlowScan}" />
                    <Border Width="28" Height="3" CornerRadius="1.5" Background="#A5B4FC"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Effect="{StaticResource Effect.GlowScan}" />
                    <Border Width="3" Height="28" CornerRadius="1.5" Background="#A5B4FC"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Effect="{StaticResource Effect.GlowScan}" />
                    <Border Width="28" Height="3" CornerRadius="1.5" Background="#A5B4FC"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Effect="{StaticResource Effect.GlowScan}" />
                    <Border Width="3" Height="28" CornerRadius="1.5" Background="#A5B4FC"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Effect="{StaticResource Effect.GlowScan}" />

                    <!-- линия сканирования (2 сек, цикл) -->
                    <Border x:Name="ScanLine" Height="2" Margin="6,0"
                            VerticalAlignment="Top"
                            Background="{StaticResource Brush.ScanLine}"
                            Effect="{StaticResource Effect.GlowScan}">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================================================== ПРАВАЯ ПАНЕЛЬ -->

        <Border Grid.Column="1"
                CornerRadius="20"
                Background="{DynamicResource Brush.Panel}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                Effect="{StaticResource Effect.ShadowMd}">
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ГРУППА" Style="{StaticResource Txt.Label}" />

                <ComboBox Grid.Row="1" Margin="0,10,0,0"
                          Style="{StaticResource Widget.Dropdown}"
                          ItemsSource="{Binding Groups}"
                          SelectedItem="{Binding SelectedGroup}"
                          DisplayMemberPath="Name"
                          IsEnabled="{Binding IsGroupSelectorEnabled}" />

                <Button Grid.Row="2" Margin="0,12,0,0"
                        Command="{Binding StartStopCommand}"
                        Content="{Binding ButtonText}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RollcallState}" Value="Active">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Green}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RollcallState}" Value="Finished">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Red}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- статистика -->
                <Border Grid.Row="3" Margin="0,16,0,0" CornerRadius="16"
                        Background="{DynamicResource Brush.Panel3}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="96" Height="96">
                            <controls:CircularProgress Percent="{Binding Percent}">
                                <controls:CircularProgress.Style>
                                    <Style TargetType="{x:Type controls:CircularProgress}"
                                           BasedOn="{StaticResource {x:Type controls:CircularProgress}}">
                                        <Setter Property="BarBrush" Value="{DynamicResource Brush.Green}" />
                                        <Setter Property="Effect" Value="{StaticResource Effect.GlowGreen}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <Binding Path="Percent"
                                                             Converter="{StaticResource Conv.LessThan}"
                                                             ConverterParameter="0.8" />
                                                </DataTrigger.Binding>
                                                <Setter Property="BarBrush" Value="{DynamicResource Brush.Yellow}" />
                                                <Setter Property="Effect" Value="{StaticResource Effect.GlowYellow}" />
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <Binding Path="Percent"
                                                             Converter="{StaticResource Conv.LessThan}"
                                                             ConverterParameter="0.5" />
                                                </DataTrigger.Binding>
                                                <Setter Property="BarBrush" Value="{DynamicResource Brush.Red}" />
                                                <Setter Property="Effect" Value="{StaticResource Effect.GlowRed}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:CircularProgress.Style>
                            </controls:CircularProgress>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PercentText}" FontSize="19"
                                           FontFamily="{StaticResource Font.ExtraBold}"
                                           Foreground="{DynamicResource Brush.Text}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding RatioText}" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextSoft}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Green}"
                                         Margin="0,1,8,0" VerticalAlignment="Top" />
                                <TextBlock Text="Присутствуют" Style="{StaticResource Txt.Body}" />
                                <TextBlock Text="{Binding PresentCount}" Margin="10,0,0,0"
                                           FontFamily="{StaticResource Font.SemiBold}" FontSize="13"
                                           Foreground="{DynamicResource Brush.Green}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Red}"
                                         Margin="0,1,8,0" VerticalAlignment="Top" />
                                <TextBlock Text="Отсутствуют" Style="{StaticResource Txt.Body}" />
                                <TextBlock Text="{Binding AbsentCount}" Margin="10,0,0,0"
                                           FontFamily="{StaticResource Font.SemiBold}" FontSize="13"
                                           Foreground="{DynamicResource Brush.Red}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="4" Text="СПИСОК СТУДЕНТОВ" Style="{StaticResource Txt.Label}"
                           Margin="0,18,0,0" />

                <ScrollViewer Grid.Row="5" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="2,11" BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number}"
                                                   FontSize="12" FontFamily="{StaticResource Font.Medium}"
                                                   Foreground="{DynamicResource Brush.TextSoft}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding FullName}"
                                                   Style="{StaticResource Txt.Body}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Border x:Name="Badge" Grid.Column="2"
                                                CornerRadius="20" Padding="11,4"
                                                Background="{DynamicResource Brush.RedSoft}"
                                                TextElement.Foreground="{DynamicResource Brush.Red}"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform />
                                            </Border.RenderTransform>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Txt.Badge}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                        <Setter TargetName="Badge" Property="Background"
                                                Value="{DynamicResource Brush.GreenSoft}" />
                                        <Setter TargetName="Badge" Property="TextElement.Foreground"
                                                Value="{DynamicResource Brush.Green}" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Badge"
                                                                                   Storyboard.TargetProperty="RenderTransform.ScaleX">
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.18">
                                                            <EasingDoubleKeyFrame.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </EasingDoubleKeyFrame.EasingFunction>
                                                        </EasingDoubleKeyFrame>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="1" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Badge"
                                                                                   Storyboard.TargetProperty="RenderTransform.ScaleY">
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1.18">
                                                            <EasingDoubleKeyFrame.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </EasingDoubleKeyFrame.EasingFunction>
                                                        </EasingDoubleKeyFrame>
                                                        <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="1" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
