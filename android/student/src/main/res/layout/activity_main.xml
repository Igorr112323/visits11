<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- логотип КубГАУ -->
    <ImageView
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo"
        android:contentDescription="КубГАУ" />

    <!-- статус после входа: ждём прикладывания телефона -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="@color/textDim"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- вход: только два способа — камера или картинка из галереи -->
    <LinearLayout
        android:id="@+id/entryPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="26dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="Вход по QR-коду студента"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="18dp"
            android:text="Свой код можно отсканировать камерой или сохранить картинкой и выбрать её из галереи"
            android:textColor="@color/textDim"
            android:textSize="13sp" />

        <Button
            android:id="@+id/scanButton"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:background="@drawable/button_bg"
            android:stateListAnimator="@null"
            android:text="Сканировать QR-код"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/galleryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_soft_bg"
            android:stateListAnimator="@null"
            android:text="Загрузить из галереи"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="15sp" />
    </LinearLayout>

    <!--
      Сканирование камерой — внутри этого же окна: своя системная камера,
      без сторонних экранов и библиотек-сканеров.
    -->
    <FrameLayout
        android:id="@+id/scannerPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <!-- кадр камеры: заполняет окно целиком, без растяжения (размер считает код) -->
        <FrameLayout
            android:id="@+id/previewFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <SurfaceView
                android:id="@+id/cameraPreview"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/scanHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#99000000"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="22dp"
            android:text="Наведите камеру на QR-код студента"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/cancelScanButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="36dp"
            android:background="@drawable/button_soft_bg"
            android:minWidth="170dp"
            android:stateListAnimator="@null"
            android:text="Отмена"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="15sp" />
    </FrameLayout>

</FrameLayout>
