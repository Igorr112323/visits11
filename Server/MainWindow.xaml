<Window x:Class="Visits11.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="КубГАУ · Сервер посещаемости"
        Width="760" Height="680" MinWidth="680" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#071B16" FontFamily="{StaticResource FontBody}">
    <Border CornerRadius="22" Background="#0B211B" BorderBrush="#254239" BorderThickness="1" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#102820" CornerRadius="22,22,0,0" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#38C878" Margin="0,0,9,0" />
                        <TextBlock Text="КубГАУ · Сервер посещаемости" Foreground="#EAF3EE" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Width="44" Height="40" Content="—" Foreground="#BED0C6" Background="Transparent" BorderThickness="0" Click="Minimize_OnClick" />
                        <Button Width="44" Height="40" Content="×" Foreground="#BED0C6" Background="Transparent" BorderThickness="0" Click="Close_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34,30,34,30">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="68" Height="68" Source="/Assets/kubgau-logo.jpg" Stretch="Uniform" />
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Сервер КубГАУ" Foreground="#F0F7F3" FontSize="26" FontWeight="Bold" />
                            <TextBlock Text="Синхронизация отметок посещаемости" Foreground="#9DB3A7" FontSize="13" Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#112C23" BorderBrush="#254239" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,28,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding StatusText}" Foreground="#ECF4EF" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding DetailText}" Foreground="#9DB3A7" FontSize="12" TextWrapping="Wrap" Margin="20,8,0,0" />
                            <TextBlock Text="Ожидают получения преподавателем" Foreground="#9DB3A7" FontSize="12" Margin="0,22,0,0" />
                            <TextBlock Text="{Binding PendingCount}" Foreground="#47D585" FontSize="32" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Адреса сервера" Foreground="#ECF4EF" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,10" />
                    <Border Background="#102820" BorderBrush="#254239" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel>
                            <TextBlock Text="На этом компьютере" Foreground="#9DB3A7" FontSize="12" />
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Копировать" Tag="{Binding LocalAddress}" Click="Copy_OnClick" Background="#1A4B37" Foreground="#D9F1E2" BorderThickness="0" Padding="12,7" />
                                <TextBlock Text="{Binding LocalAddress}" Foreground="#ECF4EF" FontSize="14" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="Для телефонов в той же Wi-Fi-сети" Foreground="#9DB3A7" FontSize="12" Margin="0,16,0,0" />
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Копировать" Tag="{Binding LanAddress}" Click="Copy_OnClick" Background="#1A4B37" Foreground="#D9F1E2" BorderThickness="0" Padding="12,7" />
                                <TextBlock Text="{Binding LanAddress}" Foreground="#ECF4EF" FontSize="14" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Ключ подключения преподавательского журнала" Foreground="#ECF4EF" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,10" />
                    <Border Background="#102820" BorderBrush="#254239" BorderThickness="1" CornerRadius="14" Padding="16">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Копировать ключ" Click="CopyKey_OnClick" Background="#1A4B37" Foreground="#D9F1E2" BorderThickness="0" Padding="12,8" Margin="12,0,0,0" />
                            <TextBox Text="{Binding SyncKey}" IsReadOnly="True" Background="Transparent" Foreground="#C8D8CF" BorderThickness="0" FontSize="12" TextWrapping="Wrap" VerticalContentAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <TextBlock Text="Сохранённые данные" Foreground="#ECF4EF" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,10" />
                    <TextBlock Text="{Binding DatabasePath}" Foreground="#9DB3A7" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="Для теста серверный EXE и преподавательский журнал запускаются на одном ПК. Телефон подключается к LAN-адресу, а не к localhost." Foreground="#9DB3A7" FontSize="12" TextWrapping="Wrap" Margin="0,22,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
