<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================== СВЕТЛАЯ ТЕМА ===== -->

    <SolidColorBrush x:Key="Brush.Bg" Color="#F4F6FB" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Panel3" Color="#EEF1F8" />
    <SolidColorBrush x:Key="Brush.Panel4" Color="#E4E9F5" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E1E6F0" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#CDD5E5" />

    <SolidColorBrush x:Key="Brush.Text" Color="#1A1F36" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#6B7690" />
    <SolidColorBrush x:Key="Brush.TextSoft" Color="#97A0B8" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#6366F1" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#8B5CF6" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#EEF0FF" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Green" Color="#10B981" />
    <SolidColorBrush x:Key="Brush.GreenSoft" Color="#E7F9F2" />
    <SolidColorBrush x:Key="Brush.Red" Color="#EF4444" />
    <SolidColorBrush x:Key="Brush.RedSoft" Color="#FDECEC" />
    <SolidColorBrush x:Key="Brush.Yellow" Color="#F59E0B" />
    <SolidColorBrush x:Key="Brush.YellowSoft" Color="#FEF6E7" />

    <!-- Полупрозрачный топбар -->
    <SolidColorBrush x:Key="Brush.Topbar" Color="#CCFFFFFF" />

    <!-- Панель камеры -->
    <LinearGradientBrush x:Key="Brush.Camera.Bg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1F36" Offset="0" />
        <GradientStop Color="#2A3054" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Camera.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Camera.TextDim" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="Brush.Camera.IconBg" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Camera.IconBorder" Color="#26FFFFFF" />

    <!-- Радиальные подсветки фона окна -->
    <RadialGradientBrush x:Key="Brush.Bg.Glow1" Center="0.16,0.0" GradientOrigin="0.16,0.0" RadiusX="0.55" RadiusY="0.5">
        <GradientStop Color="#1A6366F1" Offset="0" />
        <GradientStop Color="#006366F1" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.Bg.Glow2" Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.6" RadiusY="0.55">
        <GradientStop Color="#1A8B5CF6" Offset="0" />
        <GradientStop Color="#008B5CF6" Offset="1" />
    </RadialGradientBrush>

    <!-- Градиенты кнопок -->
    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.VioletGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0" />
        <GradientStop Color="#7C3AED" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
