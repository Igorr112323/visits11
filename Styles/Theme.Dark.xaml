<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================== ТЁМНАЯ ТЕМА ===== -->

    <SolidColorBrush x:Key="Brush.Bg" Color="#0A0D1A" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#141827" />
    <SolidColorBrush x:Key="Brush.Panel3" Color="#1C2136" />
    <SolidColorBrush x:Key="Brush.Panel4" Color="#252B45" />
    <SolidColorBrush x:Key="Brush.Border" Color="#2A3150" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#3B4467" />

    <SolidColorBrush x:Key="Brush.Text" Color="#F0F2FA" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#9099B8" />
    <SolidColorBrush x:Key="Brush.TextSoft" Color="#656D8F" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#818CF8" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#A78BFA" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#26818CF8" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Green" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.GreenSoft" Color="#1A34D399" />
    <SolidColorBrush x:Key="Brush.Red" Color="#F87171" />
    <SolidColorBrush x:Key="Brush.RedSoft" Color="#1AF87171" />
    <SolidColorBrush x:Key="Brush.Yellow" Color="#FBBF24" />
    <SolidColorBrush x:Key="Brush.YellowSoft" Color="#1AFBBF24" />

    <!-- Полупрозрачный топбар -->
    <SolidColorBrush x:Key="Brush.Topbar" Color="#CC141827" />

    <!-- Панель камеры -->
    <LinearGradientBrush x:Key="Brush.Camera.Bg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A0D1A" Offset="0" />
        <GradientStop Color="#1C2136" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Camera.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Camera.TextDim" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="Brush.Camera.IconBg" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Camera.IconBorder" Color="#26FFFFFF" />

    <!-- Радиальные подсветки фона окна -->
    <RadialGradientBrush x:Key="Brush.Bg.Glow1" Center="0.16,0.0" GradientOrigin="0.16,0.0" RadiusX="0.55" RadiusY="0.5">
        <GradientStop Color="#26818CF8" Offset="0" />
        <GradientStop Color="#00818CF8" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.Bg.Glow2" Center="0.95,1.0" GradientOrigin="0.95,1.0" RadiusX="0.6" RadiusY="0.55">
        <GradientStop Color="#26A78BFA" Offset="0" />
        <GradientStop Color="#00A78BFA" Offset="1" />
    </RadialGradientBrush>

    <!-- Градиенты кнопок -->
    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#818CF8" Offset="0" />
        <GradientStop Color="#A78BFA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.VioletGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A78BFA" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
