<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Visits11.Controls">

    <!-- ==================================================== ЭФФЕКТЫ ========= -->

    <DropShadowEffect x:Key="Effect.ShadowSm" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35" Color="#1E2246" />
    <DropShadowEffect x:Key="Effect.ShadowMd" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.10" Color="#1E2246" />
    <DropShadowEffect x:Key="Effect.ShadowLg" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.14" Color="#1E2246" />
    <DropShadowEffect x:Key="Effect.GlowScan" BlurRadius="14" ShadowDepth="0" Opacity="0.9" Color="#A5B4FC" />
    <DropShadowEffect x:Key="Effect.GlowGreen" BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="#10B981" />
    <DropShadowEffect x:Key="Effect.GlowYellow" BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="#F59E0B" />
    <DropShadowEffect x:Key="Effect.GlowRed" BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="#EF4444" />

    <!-- ==================================================== ТЕКСТ =========== -->

    <Style x:Key="Txt.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <Style x:Key="Txt.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <Style x:Key="Txt.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSoft}" />
    </Style>

    <Style x:Key="Txt.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <Style x:Key="Txt.Dim" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
    </Style>

    <Style x:Key="Txt.Badge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Txt.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
    </Style>

    <!-- ==================================================== КНОПКИ ========== -->

    <ControlTemplate x:Key="Tpl.Button" TargetType="Button">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding controls:Widget.Radius}"
                Effect="{TemplateBinding Effect}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="False" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.08" />
                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.08" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Btn.Primary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.SemiBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="controls:Widget.Radius" Value="14" />
        <Setter Property="Template" Value="{StaticResource Tpl.Button}" />
    </Style>

    <Style x:Key="Btn.Green" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Background" Value="{DynamicResource Brush.Green}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="40" />
        <Setter Property="controls:Widget.Radius" Value="12" />
    </Style>

    <Style x:Key="Btn.Violet" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Background" Value="{DynamicResource Brush.VioletGradient}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="40" />
        <Setter Property="controls:Widget.Radius" Value="12" />
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel3}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="40" />
        <Setter Property="controls:Widget.Radius" Value="12" />
    </Style>

    <Style x:Key="Btn.Soft" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.SemiBold}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="controls:Widget.Radius" Value="10" />
    </Style>

    <Style x:Key="Btn.Icon" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" CornerRadius="12" Background="Transparent"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Panel3}" />
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style x:Key="Btn.Chip" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource Brush.Panel3}" Padding="8,4">
                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ==================================================== ВКЛАДКИ ========= -->

    <Style x:Key="Widget.TabToggle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="RadioButton">
                <Border x:Name="Bd" CornerRadius="12" Padding="12,8" Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="Icon"
                              Data="{TemplateBinding Tag}"
                              Width="18" Height="18" Stretch="Uniform"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.7"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Margin="0,1,8,0" />
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Panel3}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ==================================================== ВВОД ============ -->

    <Style x:Key="Widget.Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="TextBox">
                <Border x:Name="Bd" CornerRadius="12"
                        Background="{DynamicResource Brush.Panel3}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ==================================================== СКРОЛЛБАР ======= -->

    <ControlTemplate x:Key="Tpl.ScrollBarThumb" TargetType="Thumb">
        <Border x:Name="Bd" Background="{DynamicResource Brush.Panel4}" CornerRadius="4" Margin="2" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BorderStrong}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Tpl.ScrollBarVertical" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                    <Thumb Template="{StaticResource Tpl.ScrollBarThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="Tpl.ScrollBarHorizontal" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.Thumb>
                    <Thumb Template="{StaticResource Tpl.ScrollBarThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource Tpl.ScrollBarVertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template" Value="{StaticResource Tpl.ScrollBarHorizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================================================== БЕЙДЖИ ========== -->

    <Style x:Key="Badge.Base" TargetType="Border">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel4}" />
    </Style>

    <Style x:Key="Badge.Green" TargetType="Border" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.GreenSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Green}" />
    </Style>

    <Style x:Key="Badge.Red" TargetType="Border" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.RedSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Red}" />
    </Style>

    <Style x:Key="Badge.Yellow" TargetType="Border" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.YellowSoft}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Yellow}" />
    </Style>

    <!-- ==================================================== КАРТОЧКИ ======== -->

    <Style x:Key="Card.Stat" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Effect" Value="{StaticResource Effect.ShadowSm}" />
    </Style>

    <!-- ==================================================== ДРОПДАУН ======== -->

    <ControlTemplate x:Key="Tpl.ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" CornerRadius="12"
                Background="{DynamicResource Brush.Panel3}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Widget.Dropdown" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" CornerRadius="10" Padding="12,10" Margin="4,2" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter VerticalAlignment="Center" />
                                        <Ellipse x:Name="Dot" Grid.Column="1" Width="6" Height="6"
                                                 Fill="{DynamicResource Brush.OnAccent}"
                                                 Visibility="Collapsed" Margin="10,0,4,0" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
                                        <Setter TargetName="Bd" Property="TextElement.Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Template="{StaticResource Tpl.ComboToggle}" />
                        <ContentPresenter IsHitTestVisible="False"
                                          Margin="14,0,40,0"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          TextElement.Foreground="{DynamicResource Brush.Text}" />
                        <Path x:Name="Chevron"
                              Data="{StaticResource Icon.ChevronDown}"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{DynamicResource Brush.TextDim}"
                              StrokeThickness="1.8" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Right" Margin="0,0,14,0"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=Toggle}"
                               VerticalOffset="6"
                               StaysOpen="False">
                            <Border Margin="8" Padding="6" CornerRadius="14"
                                    MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=Popup}}"
                                    Background="{DynamicResource Brush.Panel}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    Effect="{StaticResource Effect.ShadowLg}">
                                <Border x:Name="PopupInner" Opacity="0" RenderTransformOrigin="0.5,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="PopupInner"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.16" />
                                                    <DoubleAnimation Storyboard.TargetName="PopupInner"
                                                                     Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                     From="0.96" To="1" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="PopupInner"
                                                                     Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                     From="0.96" To="1" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         To="180" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== КАРТОЧКА ГРУППЫ -->

    <Style x:Key="Widget.GroupCard" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="12" Padding="12,13"
                            Background="{DynamicResource Brush.Panel3}"
                            BorderBrush="Transparent" BorderThickness="1.2"
                            TextElement.Foreground="{DynamicResource Brush.Text}">
                        <Border.RenderTransform>
                            <TranslateTransform X="0" />
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="CountBadge" Grid.Column="1" CornerRadius="20"
                                    Padding="9,3" Background="{DynamicResource Brush.Panel4}">
                                <TextBlock x:Name="CountText" Text="{Binding Count}"
                                           FontSize="12" FontFamily="{StaticResource Font.SemiBold}"
                                           Foreground="{DynamicResource Brush.TextDim}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="RenderTransform.X"
                                                         To="4" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="RenderTransform.X"
                                                         To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource Conv.Equal}">
                                    <Binding />
                                    <Binding Path="DataContext.SelectedGroup"
                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentGradient}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF" />
                            <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#FFFFFF" />
                            <Setter TargetName="CountBadge" Property="Background" Value="#33FFFFFF" />
                            <Setter TargetName="CountText" Property="Foreground" Value="#FFFFFF" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================== КАРТОЧКА ЗАНЯТИЯ -->

    <Style x:Key="Widget.LessonCard" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="12" Padding="12,12"
                            Background="{DynamicResource Brush.Panel3}"
                            BorderBrush="Transparent" BorderThickness="1.2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Panel4}" />
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource Conv.Equal}">
                                    <Binding Path="." />
                                    <Binding Path="DataContext.SelectedLesson"
                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== КРУГОВОЙ ПРОГРЕСС -->

    <Style TargetType="{x:Type controls:CircularProgress}">
        <Setter Property="BarBrush" Value="{DynamicResource Brush.Green}" />
        <Setter Property="TrackBrush" Value="{DynamicResource Brush.Panel4}" />
        <Setter Property="BarThickness" Value="9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CircularProgress}">
                    <Grid>
                        <Ellipse Margin="4.5" Stroke="{TemplateBinding TrackBrush}" StrokeThickness="{TemplateBinding BarThickness}" />
                        <Path x:Name="PART_Bar"
                              Stroke="{TemplateBinding BarBrush}"
                              StrokeThickness="{TemplateBinding BarThickness}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
